datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model Despliegue {
  id            Int         @id @default(autoincrement())
  fecha         DateTime
  programa      Programa    @relation(fields: [programaId], references: [id], onDelete: Cascade)
  programaId    Int
  entorno       String
  version       String
  accion        String?
  responsable   Responsable @relation(fields: [responsableId], references: [id], onDelete: Cascade)
  responsableId Int
  comentario    String?
}

model Programa {
  id          Int          @id @default(autoincrement())
  nombre      String       @unique
  despliegues Despliegue[]
}

model Responsable {
  id          Int          @id @default(autoincrement())
  nombre      String       @unique
  despliegues Despliegue[]
}
