// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Programa {
  id          Int          @id @default(autoincrement())
  nombre      String       @unique
  despliegues Despliegue[]
}

model Responsable {
  id          Int          @id @default(autoincrement())
  nombre      String       @unique
  despliegues Despliegue[]
}

model Despliegue {
  id             Int         @id @default(autoincrement())
  fecha          DateTime
  entorno        String // "Preproducción" or "Producción"
  version        String
  accion         String?
  comentario     String?
  programa       Programa    @relation(fields: [programaId], references: [id])
  programaId     Int
  responsable    Responsable @relation(fields: [responsableId], references: [id])
  responsableId  Int
}
