datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl"]
}

model Despliegue {
  id            Int      @id @default(autoincrement())
  fecha         DateTime
  entorno       String
  version       String
  accion        String?
  comentario    String?
  programaId    Int
  responsableId Int
  programa      Programa    @relation(fields: [programaId], references: [id], onDelete: Cascade)
  responsable   Responsable @relation(fields: [responsableId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Programa {
  id          Int          @id @default(autoincrement())
  nombre      String       @unique
  despliegues Despliegue[]
}

model Responsable {
  id          Int          @id @default(autoincrement())
  nombre      String       @unique
  despliegues Despliegue[]
}
