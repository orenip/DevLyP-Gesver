datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

model Despliegue {
  id            Int         @id @default(autoincrement())
  fecha         DateTime
  programaId    Int
  entorno       String
  version       String
  accion        String?
  responsableId Int
  comentario    String?
  programa      Programa    @relation(fields: [programaId], references: [id], onDelete: Cascade)
  responsable   Responsable @relation(fields: [responsableId], references: [id], onDelete: Cascade)
}

model Programa {
  id          Int          @id @default(autoincrement())
  nombre      String       @unique
  despliegues Despliegue[]
}

model Responsable {
  id          Int          @id @default(autoincrement())
  nombre      String       @unique
  despliegues Despliegue[]
}
